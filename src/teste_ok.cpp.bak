#include <Arduino.h>
#include "LGFX_ESP32_8048S070.h"

// Teste ISOLADO sem LVGL - use para validar hardware vs software
// Para usar: renomeie src/main.cpp para main_backup.cpp e este para main.cpp
// Depois compile e grave. Deve mostrar cores vivas sem estourar branco.

static LGFX tft;

void setup() {
  Serial.begin(115200);
  Serial.println("Teste display 8048S070 - iniciado");

  tft.init();
  tft.setRotation(0);
  
  // *** CORRECAO DE BRILHO - TESTE 3 NIVEIS ***
  // 0-255, comece em 128. Se 255 o branco estoura e parece lavado na foto
  tft.setBrightness(128);
  Serial.println("Brilho 128");

  // Teste 1: Vermelho puro
  tft.fillScreen(TFT_RED);
  Serial.println("Tela VERMELHA - deve ser vermelho vivo, nao rosa claro");
  delay(2000);

  // Teste 2: Verde
  tft.fillScreen(TFT_GREEN);
  Serial.println("Tela VERDE");
  delay(2000);

  // Teste 3: Azul
  tft.fillScreen(TFT_BLUE);
  Serial.println("Tela AZUL - deve ser azul escuro, nao ciano lavado");
  delay(2000);

  // Teste 4: Preto
  tft.fillScreen(TFT_BLACK);
  Serial.println("Tela PRETA - deve ser preto real, nao cinza azulado");
  tft.setTextColor(TFT_WHITE);
  tft.setTextSize(3);
  tft.setCursor(100, 220);
  tft.print("PRETO OK?");
  delay(3000);

  // Teste 5: Branco
  tft.fillScreen(TFT_WHITE);
  Serial.println("Tela BRANCA");
  tft.setTextColor(TFT_BLACK);
  tft.setCursor(100, 220);
  tft.print("BRANCO OK?");
  delay(2000);

  // Teste 6: Gradiente - volta para brilho variavel
  for (int b = 40; b <= 255; b += 20) {
    tft.setBrightness(b);
    tft.fillScreen(tft.color565(30, 30, 30));
    tft.setTextColor(TFT_WHITE);
    tft.setCursor(180, 220);
    tft.printf("Brilho %d", b);
    Serial.printf("Brilho %d\n", b);
    delay(800);
  }
  
  // Volta para brilho ideal
  tft.setBrightness(140);
  tft.fillScreen(TFT_BLACK);
  tft.setCursor(60, 200);
  tft.setTextColor(TFT_CYAN);
  tft.print("Se viu cores vivas: HW OK!");
  tft.setCursor(60, 240);
  tft.setTextColor(TFT_WHITE);
  tft.setTextSize(2);
  tft.print("Problema era timing/brilho");
  Serial.println("Teste finalizado - se cores estavam vivas, troque LGFX e brilho no seu main.cpp");
}

void loop() {
  delay(1000);
}
